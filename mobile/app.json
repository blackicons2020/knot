{
  "expo": {
    "name": "Knot",
    "slug": "knot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A0D67"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.knot.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Knot to access your camera for liveness verification.",
        "NSPhotoLibraryUsageDescription": "Knot needs photo library access so you can pick profile photos.",
        "NSMicrophoneUsageDescription": "Knot needs microphone access for video calls."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A0D67"
      },
      "package": "com.knot.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Knot to access your camera."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Knot to access your photos."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Allow Knot to access your camera for liveness verification.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraParams": "-Dorg.gradle.jvmargs=-Xmx4096m",
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "45b39bd1-1cb0-4f70-af84-f4c54f02a5d4"
      }
    },
    "owner": "johnmeke2026"
  }
}
